# Copy this file to .env for local testing, or set these as real
# environment variables in your host (e.g. Railway "Variables" tab).
# Never commit a real .env file or paste your key into chat.

ODDS_API_KEY=
ODDS_API_BASE_URL=https://api.the-odds-api.com

# Comma-separated bookmaker keys (confirmed real, from The Odds API's own
# "bookmaker-apis.html" docs page). Mixes US-wide books confirmed accurate
# for Ontario by direct comparison (FanDuel, DraftKings, theScore Bet) with
# Ontario-specific book variants that need the region-specific key to get
# the right price (BetMGM, BetRivers, Betano) - "bookmakers" can combine
# keys from any region in one request per their docs.
ODDS_API_BOOKS=fanduel,draftkings,betmgm_ca_on,betrivers_ca_on,betano_ca_on,espnbet

# Optional - default sport group/league shown before any filter is toggled.
ODDS_API_SPORT_GROUP=American Football
ODDS_API_LEAGUE=americanfootball_nfl

PORT=5000
# Set to 1 only for local debugging — never in production.
FLASK_DEBUG=0
