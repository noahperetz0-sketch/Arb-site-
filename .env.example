# Copy this file to .env for local testing, or set these as real
# environment variables in your host (e.g. Railway "Variables" tab).
# Never commit a real .env file or paste your key into chat.

SHARPAPI_KEY=
SHARPAPI_BASE_URL=https://api.sharpapi.io

# The 5 sportsbooks your Hobby plan is scoped to, comma-separated ids.
# Betano has no NFL data on this feed (confirmed working for other sports
# like soccer/tennis) — it will contribute nothing while SHARPAPI_LEAGUE is
# nfl, but is a real, working book for whatever sport it does cover.
SHARPAPI_BOOKS=betrivers,fanduel,betmgm,draftkings,betano

# Optional. BetMGM, Caesars, and BetRivers have state-dependent deep link
# URLs (confirmed in SharpAPI's own /odds docs) - set your two-letter state
# code (e.g. nj, ny, il) if you bet from a state where one of those books
# operates, so Place Bet links resolve to the right state's domain. Leave
# blank otherwise.
SHARPAPI_STATE=

PORT=5000
# Set to 1 only for local debugging — never in production.
FLASK_DEBUG=0
